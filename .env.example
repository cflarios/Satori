# Copy this file to .env and paste your API key from https://console.anthropic.com
# Recommended: create the key with an expiration date and no admin permissions.
ANTHROPIC_API_KEY=sk-ant-...

# --- Network camera (optional) ---
# RTSP/HTTP stream of a Wi-Fi IP camera, used by the web "Network camera" source
# and by `python app.py --camera net`. E.g. a V380 with RTSP enabled:
# rtsp://192.168.1.9:554/live/ch00_0
CAMERA_URL=

# --- MQTT (optional) ---
# If MQTT_BROKER is empty, the apps run without publishing anything.
# For local Mosquitto, this is usually your PC's IP on the network (not
# 127.0.0.1, which an ESP32 could not reach). E.g.: 192.168.1.50
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=satori/answers
# Leave empty if your Mosquitto allows anonymous connections.
MQTT_USER=
MQTT_PASSWORD=
MQTT_QOS=1
